#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	python3 -c 'import ast,json,pathlib; ast.parse(pathlib.Path("debian/download.py").read_text()); json.loads(pathlib.Path("upstream.json").read_text())'

override_dh_auto_test:

override_dh_auto_install:
	install -D -m755 files/sliver-server debian/sv-sliver/usr/bin/sliver-server
	install -D -m755 files/sliver-client debian/sv-sliver/usr/bin/sliver-client
	install -D -m755 files/sliver-check debian/sv-sliver/usr/bin/sliver-check
	install -D -m644 debian/download.py debian/sv-sliver/usr/libexec/svent/sliver-download.py
	install -D -m644 upstream.json debian/sv-sliver/usr/share/svent/downloads/sliver.json
	install -D -m644 catalog.d/sliver.json debian/sv-sliver/usr/share/svent/catalog.d/sliver.json
	install -D -m644 files/upstream-license debian/sv-sliver/usr/share/doc/sv-sliver/upstream-license
	install -D -m644 upstream.json debian/sv-sliver/usr/share/doc/sv-sliver/upstream.json

override_dh_auto_clean:
