{
  "schema": 1,
  "name": "havoc",
  "group": "c2",
  "description": "Havoc C2 framework",
  "packaging": "svent",
  "package": "sv-havoc",
  "executables": [
    "havoc",
    "havoc-client"
  ],
  "official_source": "https://github.com/HavocFramework/Havoc",
  "version_policy": "pinned",
  "functional_test": [
    "havoc",
    "--help"
  ],
  "functional_test_any_exit": false,
  "desktop_file": "svent-havoc.desktop",
  "isolation": {
    "kind": "compiled-with-private-state",
    "prefix": "/opt/sv-havoc",
    "state": "$XDG_DATA_HOME/svent/havoc"
  }
}
